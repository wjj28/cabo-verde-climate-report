{
  "name": "cabo-verde-climate-report",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent concept: a static, multilingual climate report microsite for Cabo Verde",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "pdf": "node scripts/make-pdfs.mjs",
    "og": "node scripts/make-og.mjs",
    "test:a11y": "node scripts/a11y.mjs",
    "release": "npm run build && npm run pdf && npm run build && npm run test:a11y",
    "build:all": "bash scripts/build-all.sh",
    "data:cities": "node scripts/build-data-cities.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "astro": "^5.18.2",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "axe-core": "4.10",
    "pagefind": "^1.6.0",
    "puppeteer-core": "^23.11.1"
  },
  "engines": {
    "node": ">=20"
  }
}
