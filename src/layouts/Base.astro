---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import { languages, langs, t, type Lang } from '../i18n/ui';
import { url } from '../lib/url';
import { getReport } from '../lib/content';

interface Props {
  lang: Lang;
  title?: string;
  description: string;
  /** path after the language prefix, e.g. "chapters/observed-climate/" — used for hreflang and the language switcher */
  path: string;
  image?: string;
  type?: 'website' | 'article';
  /** false for utility pages (print, search) that should not appear in search engines or site search */
  index?: boolean;
  /** page exists in one language only: no hreflang alternates, language menu goes to each home page */
  single?: boolean;
}
const { lang, title, description, path, image = 'og/cover.png', type = 'website', index = true, single = false } = Astro.props;
const s = t(lang);
const report = await getReport(lang);
const dir = languages[lang].dir;
const pageTitle = title ? `${title} | ${report.shortTitle}` : `${report.title}: ${report.subtitle}`;
const canonical = new URL(url(`${lang}/${path}`), Astro.site).href;
const ogImage = new URL(url(image), Astro.site).href;
const current = Astro.url.pathname;
const nav = [
  { href: `${lang}/`, label: s.nav.home },
  { href: `${lang}/summary/`, label: s.nav.summary },
  { href: `${lang}/chapters/`, label: s.nav.chapters },
  { href: `${lang}/figures/`, label: s.nav.figures },
  { href: `${lang}/downloads/`, label: s.nav.downloads },
  { href: `${lang}/about/`, label: s.nav.about },
];
const isCurrent = (href: string) => (href === `${lang}/` ? current === url(href) : current.startsWith(url(href)));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'Report',
  name: pageTitle,
  headline: title ?? report.title,
  description,
  inLanguage: lang,
  url: canonical,
  isPartOf: { '@type': 'Report', name: report.title },
};
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!single && langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(url(`${l}/${path}`), Astro.site).href} />)}
    {!single && <link rel="alternate" hreflang="x-default" href={new URL(url(`en/${path}`), Astro.site).href} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={report.title} />
    <meta property="og:title" content={title ?? report.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={languages[lang].og} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={languages[l].og} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b3a53" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {!index && <meta name="robots" content="noindex" />}
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>
    <aside class="concept-bar" aria-label={s.concept}>
      <div class="wrap"><strong>{s.concept}</strong><span class="concept-text">{s.conceptShort}</span><a href={url(`${lang}/about/`)}>{s.learnMore}</a></div>
    </aside>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={url(`${lang}/`)}>
          <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="19" fill="#0b3a53"/><path d="M6 25c4-3 8-3 12 0s8 3 12 0 6-2 6-2" fill="none" stroke="#7fd3e6" stroke-width="2.4" stroke-linecap="round"/><circle cx="25" cy="14" r="5" fill="#f2a541"/></svg>
          <span class="brand-text"><span class="brand-title">{report.shortTitle}</span><span class="brand-sub">{report.edition}</span></span>
        </a>
        <nav class="main-nav" aria-label={s.menu}>
          <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-list">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2"/></svg>
            <span>{s.menu}</span>
          </button>
          <ul id="nav-list">
            {nav.map((n) => <li><a href={url(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
          </ul>
        </nav>
        <div class="header-tools">
          <a class="icon-btn" href={url(`${lang}/search/`)} aria-label={s.nav.search}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-4-4" stroke="currentColor" stroke-width="2"/></svg>
          </a>
          <details class="lang-menu">
            <summary aria-label={s.language}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
              <span>{languages[lang].name}</span>
            </summary>
            <ul>
              {langs.map((l) => (
                <li><a href={url(single && l !== lang ? `${l}/` : `${l}/${path}`)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{languages[l].name}</a></li>
              ))}
            </ul>
          </details>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1" data-pagefind-body={index ? '' : undefined}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-title">{report.title}</p>
          <p>{report.subtitle}</p>
        </div>
        <ul class="footer-links">
          {nav.slice(1).map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}
        </ul>
        <p class="footer-note">{s.conceptLong}</p>
      </div>
    </footer>
    <dialog class="lightbox" aria-labelledby="lightbox-title">
      <div class="lightbox-inner">
        <div class="lightbox-bar">
          <h2 id="lightbox-title"></h2>
          <button type="button" class="btn btn-ghost" data-close>{s.close} <span aria-hidden="true">✕</span></button>
        </div>
        <div class="lightbox-body"></div>
      </div>
    </dialog>
    <script src={url('js/site.js')} defer is:inline></script>
  </body>
</html>
