---
import Base from '../../layouts/Base.astro';
import { languages, t, chapterLabel, chapterTitle, type Lang } from '../../i18n/ui';
import { getChapters, getReport } from '../../lib/content';
import { figures, figureNumber } from '../../lib/figures';
import { url } from '../../lib/url';
import { langPaths } from '../../lib/paths';
import { existsSync, statSync } from 'node:fs';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const r = await getReport(lang);
const chapters = await getChapters(lang);
// PDFs are generated by `npm run pdf` into public/pdf/; show their size when present.
const size = (p: string) => {
  const f = `public/pdf/${lang}/${p}`;
  if (!existsSync(f)) return '';
  const kb = statSync(f).size / 1024;
  return kb > 1024 ? `${(kb / 1024).toFixed(1)} MB` : `${Math.round(kb)} KB`;
};
---
<Base lang={lang} title={s.nav.downloads} description={s.downloadsIntro} path="downloads/">
  <div class="page-head"><div class="wrap"><p class="eyebrow">{r.title}</p><h1>{s.nav.downloads}</h1><p class="lede">{s.downloadsIntro}</p></div></div>
  <div class="wrap section downloads">
    <section aria-labelledby="d-full">
      <h2 id="d-full">{s.fullReport}</h2>
      <a class="dl-card dl-main" href={url(`pdf/${lang}/report.pdf`)} download>
        <span class="dl-icon" aria-hidden="true">PDF</span>
        <span><strong>{r.title}</strong><span class="dl-sub">{r.subtitle}</span><span class="dl-meta">{languages[lang].name} · PDF {size('report.pdf')}</span></span>
      </a>
    </section>
    <section aria-labelledby="d-ch">
      <h2 id="d-ch">{s.chapterPdfs}</h2>
      <ul class="dl-list">
        {chapters.map((c) => (
          <li><a class="dl-card" href={url(`pdf/${lang}/chapter-${c.number}.pdf`)} download>
            <span class="dl-icon" aria-hidden="true">PDF</span>
            <span><strong>{chapterTitle(lang, c.number, c.title)}</strong><span class="dl-meta">PDF {size(`chapter-${c.number}.pdf`)}</span></span>
          </a></li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="d-data">
      <h2 id="d-data">{s.dataFiles}</h2>
      <ul class="dl-list">
        {figures.map((f) => (
          <li><a class="dl-card" href={url(`data/${f.slug}.csv`)} download>
            <span class="dl-icon csv" aria-hidden="true">CSV</span>
            <span><strong>{s.figure} {figureNumber(f.key)}: {s.fig[f.key].title}</strong><span class="dl-meta" dir="auto">{f.source}</span></span>
          </a></li>
        ))}
      </ul>
    </section>
  </div>
</Base>
