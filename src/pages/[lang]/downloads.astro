---
// Downloads: three collapsible groups (full report, chapters, data), so everything fits on one screen.
import Base from '../../layouts/Base.astro';
import { languages, t, chapterTitle, type Lang } from '../../i18n/ui';
import { getChapters, getReport } from '../../lib/content';
import { figures, figureNumber } from '../../lib/figures';
import { url } from '../../lib/url';
import { langPaths } from '../../lib/paths';
import { existsSync, statSync } from 'node:fs';
import { PDF_STORE } from '../../lib/report';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const r = await getReport(lang);
const chapters = await getChapters(lang);
// PDFs are generated by scripts/make-pdfs.mjs into the report's PDF store; show their size when present.
const bytes = (p: string) => { const f = `${PDF_STORE}/${lang}/${p}`; return existsSync(f) ? statSync(f).size : 0; };
const fmt = (b: number) => (!b ? '' : b > 1048576 ? `${(b / 1048576).toFixed(1)} MB` : `${Math.round(b / 1024)} KB`);

const groups = [
  {
    id: 'full', title: s.fullReport, kind: 'PDF',
    items: [{ href: url(`pdf/${lang}/report.pdf`), label: r.title, meta: `${languages[lang].name} · PDF ${fmt(bytes('report.pdf'))}` }],
  },
  {
    id: 'chapters', title: s.chapterPdfs, kind: 'PDF',
    items: chapters.map((c) => ({ href: url(`pdf/${lang}/chapter-${c.number}.pdf`), label: chapterTitle(lang, c.number, c.title), meta: `PDF ${fmt(bytes(`chapter-${c.number}.pdf`))}` })),
  },
  {
    id: 'data', title: s.dataFiles, kind: 'CSV',
    items: figures.map((f) => ({ href: url(`data/${f.slug}.csv`), label: `${s.figure} ${figureNumber(f.key)}: ${s.fig[f.key].title}`, meta: 'CSV' })),
  },
];
---
<Base lang={lang} title={s.nav.downloads} description={s.downloadsIntro} path="downloads/">
  <div class="page-head"><div class="wrap narrow"><p class="eyebrow">{r.title}</p><h1>{s.nav.downloads}</h1><p class="lede">{s.downloadsIntro}</p></div></div>
  <div class="wrap narrow section downloads">
    {groups.map((g) => (
      <details class="dl-group" id={`dl-${g.id}`}>
        <summary>
          <span class={`dl-icon ${g.kind === 'CSV' ? 'csv' : ''}`} aria-hidden="true">{g.kind}</span>
          <span class="dl-group-title">{g.title}</span>
          <span class="dl-group-meta">{s.files(g.items.length)}</span>
          <svg class="chev" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        </summary>
        <ul class="dl-rows">
          {g.items.map((it) => (
            <li>
              <a href={it.href} download>
                <span class="dl-row-label">{it.label}</span>
                <span class="dl-row-meta">{it.meta}</span>
                <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" fill="none" stroke="currentColor" stroke-width="2"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))}
  </div>
</Base>
