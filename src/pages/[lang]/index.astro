---
import Base from '../../layouts/Base.astro';
import Chart from '../../components/Chart.astro';
import Video from '../../components/Video.astro';
import Evidence from '../../components/Evidence.astro';
import IslandMap from '../../components/IslandMap.astro';
import { t, chapterLabel, type Lang } from '../../i18n/ui';
import { getReport, getChapters } from '../../lib/content';
import { figures } from '../../lib/figures';
import { url } from '../../lib/url';
import { langPaths } from '../../lib/paths';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const r = await getReport(lang);
const chapters = await getChapters(lang);
const stripes = figures.find((f) => f.key === 'stripes')!;
const icons = ['thermo', 'rain', 'crop', 'future', 'coast'];
---
<Base lang={lang} description={r.intro} path="">
  <section class="hero">
    <div class="hero-stripes" aria-hidden="true">
      <Chart stretch spec={stripes.spec(lang)} id="hero-stripes" title={s.fig.stripes.title} desc={s.fig.stripes.alt} lang={lang} />
    </div>
    <div class="wrap hero-inner">
      <div class="hero-text">
      <p class="eyebrow">{r.edition}</p>
      <h1>{r.title}</h1>
      <p class="hero-sub">{r.subtitle}</p>
      <p class="lede">{r.intro}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={url(`${lang}/summary/`)}>{s.readSummary} <span aria-hidden="true" class="arrow">→</span></a>
        <a class="btn btn-secondary" href={url(`pdf/${lang}/report.pdf`)} download>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" fill="none" stroke="currentColor" stroke-width="2"/></svg>
          {s.downloadReport} <span class="muted">(PDF)</span></a>
      </div>
      <p class="hero-credit"><a href={url(`${lang}/chapters/observed-climate/#fig-temperature-stripes`)}>{s.figure} 1</a> · {s.fig.stripes.title}</p>
      </div>
      <IslandMap lang={lang} />
    </div>
  </section>

  <section class="wrap stats" aria-labelledby="stats-h">
    <h2 id="stats-h" class="visually-hidden">{s.keyMessages}</h2>
    <ul class="stat-grid">
      {r.stats.map((st) => <li class="stat"><span class="stat-value" dir="ltr">{st.value}</span><span class="stat-label">{st.label}</span></li>)}
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="hl-h">
    <div class="section-head">
      <h2 id="hl-h">{s.nav.summary}</h2>
      <a href={url(`${lang}/summary/`)} class="more">{s.readSummary} <span aria-hidden="true" class="arrow">→</span></a>
    </div>
    <ol class="headline-cards">
      {r.headlines.slice(0, 4).map((h) => (
        <li class="card">
          <div class="card-top"><span class="hl-id">{h.id}</span><Evidence kind={h.evidence} lang={lang} /></div>
          <p class="card-statement">{h.statement}</p>
          <a class="stretched" href={url(`${lang}/summary/#${h.id}`)}><span class="visually-hidden">{s.readSummary}: {h.id}</span></a>
        </li>
      ))}
    </ol>
  </section>

  <section class="band-section" aria-labelledby="ch-h">
    <div class="wrap section">
      <div class="section-head"><h2 id="ch-h">{s.nav.chapters}</h2></div>
      <ol class="chapter-grid">
        {chapters.map((c, i) => (
          <li class={`chapter-card ic-${icons[i]}`}>
            <span class="chapter-num">{chapterLabel(lang, c.number)}</span>
            <h3><a href={url(`${lang}/chapters/${c.slug}/`)}>{c.title}</a></h3>
            <p class="kicker">{c.kicker}</p>
            <p>{c.summary}</p>
            <span class="chapter-meta">{c.sections.filter((x) => x.figure).length} {s.figuresCount}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {r.video && (
    <section class="wrap section video-section" aria-labelledby="vid-h">
      <div><h2 id="vid-h">{s.watch}</h2></div>
      <Video id={r.video.youtubeId} title={r.video.title} description={r.video.description} lang={lang} />
    </section>
  )}

  <section class="wrap section dl-cta" aria-labelledby="dl-h">
    <div>
      <h2 id="dl-h">{s.nav.downloads}</h2>
      <p>{s.downloadsIntro}</p>
    </div>
    <a class="btn btn-primary" href={url(`${lang}/downloads/`)}>{s.nav.downloads} <span aria-hidden="true" class="arrow">→</span></a>
  </section>
</Base>
