---
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import { t, chapterTitle, type Lang } from '../../i18n/ui';
import { getChapters, getReport } from '../../lib/content';
import { figures } from '../../lib/figures';
import { url } from '../../lib/url';
import { langPaths } from '../../lib/paths';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const r = await getReport(lang);
const chapters = await getChapters(lang);
---
<Base lang={lang} title={s.nav.figures} description={s.figuresIntro} path="figures/">
  <div class="page-head"><div class="wrap"><p class="eyebrow">{r.title}</p><h1>{s.allFigures}</h1><p class="lede">{s.figuresIntro}</p></div></div>
  <!-- one continuous two-column grid, so rows line up whatever the number of figures per chapter -->
  <div class="wrap figure-gallery">
    <div class="gallery-grid">
      {chapters.flatMap((c) => figures.filter((f) => f.chapter === c.slug).map((f, i) => (
        <div class="gallery-item">
          {i === 0
            ? <h2 class="gallery-ch"><a href={url(`${lang}/chapters/${c.slug}/`)}>{chapterTitle(lang, c.number, c.title)}</a></h2>
            : <p class="gallery-ch"><a href={url(`${lang}/chapters/${c.slug}/`)}>{chapterTitle(lang, c.number, c.title)}</a></p>}
          <Figure fig={f.key} lang={lang} />
        </div>
      )))}
    </div>
  </div>
</Base>
