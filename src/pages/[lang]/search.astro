---
// Full-text search with Pagefind: the index is built after `astro build` and runs entirely in the browser.
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n/ui';
import { url } from '../../lib/url';
import { langPaths } from '../../lib/paths';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
---
<Base lang={lang} title={s.nav.search} description={s.searchPlaceholder} path="search/" index={false}>
  <div class="page-head"><div class="wrap narrow"><h1>{s.nav.search}</h1></div></div>
  <div class="wrap narrow section" data-pagefind-ignore>
    <link href={url('pagefind/pagefind-ui.css')} rel="stylesheet" />
    <div id="search" data-placeholder={s.searchPlaceholder}></div>
    <noscript><p>{s.searchPlaceholder}: JavaScript is required.</p></noscript>
    <script is:inline define:vars={{ src: url('pagefind/pagefind-ui.js'), base: url('pagefind/') }}>
      const sc = document.createElement('script');
      sc.src = src;
      sc.onload = () => {
        const el = document.getElementById('search');
        new PagefindUI({ element: el, bundlePath: base, showSubResults: true, showImages: false, translations: { placeholder: el.dataset.placeholder } });
        const input = el.querySelector('input');
        input?.setAttribute('aria-label', el.dataset.placeholder);
        input?.focus();
      };
      document.head.appendChild(sc);
    </script>
  </div>
</Base>
