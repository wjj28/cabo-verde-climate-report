---
import Base from '../../layouts/Base.astro';
import Evidence from '../../components/Evidence.astro';
import { t, chapterLabel, chapterTitle, type Lang } from '../../i18n/ui';
import { getReport, getChapters } from '../../lib/content';
import { getFigure, figureNumber } from '../../lib/figures';
import { url } from '../../lib/url';
import { langPaths } from '../../lib/paths';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const s = t(lang);
const r = await getReport(lang);
const chapters = await getChapters(lang);
const groups = (['A', 'B', 'C'] as const).map((g) => ({ g, items: r.headlines.filter((h) => h.id.startsWith(g)) }));
---
<Base lang={lang} title={s.nav.summary} description={r.summaryIntro} path="summary/" type="article">
  <div class="page-head">
    <div class="wrap narrow">
      <p class="eyebrow">{r.title}</p>
      <h1>{s.nav.summary}</h1>
      <p class="lede">{r.summaryIntro}</p>
      <ul class="evidence-key">
        {(['observed', 'projected', 'reported'] as const).map((k) => <li><Evidence kind={k} lang={lang} /> <span>{s.evidenceHelp[k]}</span></li>)}
      </ul>
    </div>
  </div>
  <div class="wrap narrow prose-wrap">
    {groups.map(({ g, items }) => (
      <section class="hl-group" aria-labelledby={`g-${g}`}>
        <h2 id={`g-${g}`}><span class="group-letter">{g}</span> {r.groups?.[g] ?? s.groups[g]}</h2>
        {items.map((h) => {
          const f = h.figure ? getFigure(h.figure) : undefined;
          const ch = chapters.find((c) => c.slug === h.chapter);
          return (
            <article class="headline" id={h.id}>
              <div class="headline-meta"><span class="hl-id">{h.id}</span><Evidence kind={h.evidence} lang={lang} /></div>
              <h3>{h.statement}</h3>
              <p>{h.detail}</p>
              <p class="headline-links">
                {ch && <a href={url(`${lang}/chapters/${ch.slug}/`)}>{chapterTitle(lang, ch.number, ch.title)}</a>}
                {f && <a href={url(`${lang}/chapters/${f.chapter}/#fig-${f.slug}`)}>{s.seeFigure} {figureNumber(f.key)}</a>}
              </p>
            </article>
          );
        })}
      </section>
    ))}
  </div>
</Base>
