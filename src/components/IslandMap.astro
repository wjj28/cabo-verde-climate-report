---
// Interactive map of the Cabo Verde archipelago, drawn as SVG at build time from real boundary data
// (geoBoundaries, OpenStreetMap contributors, ODbL). Hover, tap or focus an island to see its climate:
// it highlights, rain falls in proportion to its annual rainfall, and a card shows area, summit,
// rainfall, temperature and monthly rainfall. public/js/site.js adds the interaction; without it
// the map is still a complete, labelled image.
import outline from '../data/cabo-verde-outline.json';
import islandData from '../data/islands.json';
import { t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const zh = lang === 'zh';
const nf = (v: number, d = 0) => new Intl.NumberFormat(lang, { maximumFractionDigits: d, minimumFractionDigits: d }).format(v);

// Equirectangular projection, corrected for latitude so the islands keep their shape.
const LON0 = -25.5, LON1 = -22.25, LAT0 = 14.62, LAT1 = 17.4;
const K = 150; // pixels per degree of latitude
const COS = Math.cos((16 * Math.PI) / 180);
const W = Math.round((LON1 - LON0) * COS * K);
const H = Math.round((LAT1 - LAT0) * K);
const x = (lon: number) => +((lon - LON0) * COS * K).toFixed(1);
const y = (lat: number) => +((LAT1 - lat) * K).toFixed(1);

type Key = keyof typeof islandData;
type Island = (typeof islandData)[Key] & { prMonthly?: number[]; prAnnual?: number; tasAnnual?: number; pointElevation?: number };
// Reference point of each island, used to assign outline polygons (islets go to the nearest island).
const centres: Record<Key, [number, number]> = {
  'santo-antao': [-25.17, 17.07], 'sao-vicente': [-24.95, 16.85], 'santa-luzia': [-24.75, 16.76], 'sao-nicolau': [-24.25, 16.6],
  sal: [-22.93, 16.74], 'boa-vista': [-22.81, 16.09], maio: [-23.17, 15.22], santiago: [-23.62, 15.08], fogo: [-24.38, 14.93], brava: [-24.7, 14.85],
};
// Label placement for each island.
const labels: Record<Key, { lon: number; lat: number; anchor: 'start' | 'middle' | 'end' }> = {
  'santo-antao': { lon: -25.17, lat: 17.3, anchor: 'middle' }, 'sao-vicente': { lon: -24.83, lat: 16.99, anchor: 'start' },
  'santa-luzia': { lon: -24.7, lat: 16.62, anchor: 'end' }, 'sao-nicolau': { lon: -24.25, lat: 16.42, anchor: 'middle' },
  sal: { lon: -23.06, lat: 16.73, anchor: 'end' }, 'boa-vista': { lon: -23.02, lat: 16.08, anchor: 'end' },
  maio: { lon: -22.99, lat: 15.2, anchor: 'start' }, santiago: { lon: -23.84, lat: 15.22, anchor: 'end' },
  fogo: { lon: -24.38, lat: 15.1, anchor: 'middle' }, brava: { lon: -24.8, lat: 14.82, anchor: 'end' },
};

const keys = Object.keys(centres) as Key[];
const polys: Record<string, number[][][]> = Object.fromEntries(keys.map((k) => [k, []]));
for (const poly of outline.polygons) {
  const ring = poly[0];
  const [cx, cy] = ring.reduce(([a, b], [lo, la]) => [a + lo / ring.length, b + la / ring.length], [0, 0]);
  const k = keys.reduce((best, key) => (Math.hypot(centres[key][0] - cx, centres[key][1] - cy) < Math.hypot(centres[best][0] - cx, centres[best][1] - cy) ? key : best), keys[0]);
  polys[k].push(...poly);
}

// Deterministic pseudo-random numbers, so the rain looks the same on every build.
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const maxMonth = Math.max(...keys.map((k) => Math.max(...((islandData[k] as Island).prMonthly ?? [0]))));

const islands = keys.map((k) => {
  const info = islandData[k] as Island;
  const rings = polys[k];
  const d = rings.map((r) => r.map(([lo, la], i) => `${i ? 'L' : 'M'}${x(lo)},${y(la)}`).join('') + 'Z').join('');
  const xs = rings.flat().map(([lo]) => x(lo)), ys = rings.flat().map(([, la]) => y(la));
  const box = { x0: Math.min(...xs), x1: Math.max(...xs), y0: Math.min(...ys), y1: Math.max(...ys) };
  const drops = Math.max(5, Math.min(28, Math.round((info.prAnnual ?? 100) / 11)));
  const rain = Array.from({ length: drops }, () => ({
    x: +(box.x0 - 4 + rand() * (box.x1 - box.x0 + 8)).toFixed(1),
    y: +(box.y0 - 26 + rand() * 14).toFixed(1),
    fall: +(box.y1 - box.y0 + 22).toFixed(1),
    delay: +(rand() * 1.1).toFixed(2),
    dur: +(0.75 + rand() * 0.45).toFixed(2),
  }));
  const name = zh ? info.zh : info.name;
  const wettest = info.prMonthly ? info.prMonthly.indexOf(Math.max(...info.prMonthly)) : -1;
  const aria = [
    name,
    `${s.map.area} ${nf(info.area)} km²`,
    `${s.map.peak} ${info.peak} ${nf(info.elevation)} m`,
    info.prAnnual != null ? `${s.map.rain} ~${nf(info.prAnnual)} ${s.map.perYear}` : '',
    info.tasAnnual != null ? `${s.map.temp} ${nf(info.tasAnnual, 1)} °C${info.pointElevation != null ? ` ${s.map.at} ${nf(info.pointElevation)} m` : ''}` : '',
  ].filter(Boolean).join(', ');
  return { k, info, d, rain, name, wettest, aria, label: labels[k] };
});

const graticule = { lats: [15, 16, 17], lons: [-25, -24, -23] };
const deg = (v: number, pos: string, neg: string) => `${Math.abs(v)}°${v >= 0 ? pos : neg}`;
const scaleKm = 50;
const scalePx = (scaleKm / (111.32 * COS)) * COS * K;
const dakar = zh ? '达喀尔' : 'Dakar';
const cities = [
  { name: 'Praia', zh: '普拉亚', lon: -23.51, lat: 14.92, below: true },
];
---
<figure class="island-map" data-island-map>
  <div class="map-stage">
    <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-labelledby="map-t" aria-describedby="map-d" xmlns="http://www.w3.org/2000/svg">
      <title id="map-t">{s.map.title}</title>
      <desc id="map-d">{s.map.desc}</desc>
      <g class="grat" aria-hidden="true">
        {graticule.lats.map((la) => <><line x1="0" x2={W} y1={y(la)} y2={y(la)} /><text x={W - 6} y={y(la) - 5} text-anchor="end">{zh ? `北纬${la}°` : deg(la, 'N', 'S')}</text></>)}
        {graticule.lons.map((lo) => <><line y1="0" y2={H} x1={x(lo)} x2={x(lo)} /><text x={x(lo) + 5} y={H - 8}>{zh ? `西经${Math.abs(lo)}°` : deg(lo, 'E', 'W')}</text></>)}
      </g>
      {islands.map((i) => (
        <g class="isl" data-island={i.k} tabindex="0" role="button" aria-label={i.aria} aria-controls={`isl-card-${i.k}`}>
          <path class="land" d={i.d} />
          <g class="rain" aria-hidden="true">
            {i.rain.map((r) => (
              <line x1={r.x} x2={r.x - 2} y1={r.y} y2={r.y + 9} style={`--fall:${r.fall}px;animation-delay:${r.delay}s;animation-duration:${r.dur}s`} />
            ))}
          </g>
        </g>
      ))}
      <g class="labels" aria-hidden="true">
        {islands.map((i) => <text data-label={i.k} x={x(i.label.lon)} y={y(i.label.lat)} text-anchor={i.label.anchor}>{i.name}</text>)}
        {cities.map((c) => (
          <>
            <circle cx={x(c.lon)} cy={y(c.lat)} r="4.5" class="city" />
            {c.below
              ? <text class="city-label" x={x(c.lon)} y={y(c.lat) + 22} text-anchor="middle">{zh ? c.zh : c.name}</text>
              : <text class="city-label" x={x(c.lon) - 10} y={y(c.lat) + 17} text-anchor="end">{zh ? c.zh : c.name}</text>}
          </>
        ))}
      </g>
      <g class="dakar" aria-hidden="true">
        <path d={`M${x(-22.75)},${y(15.55)} H${W - 10}`} />
        <path d={`M${W - 18},${y(15.55) - 6} L${W - 9},${y(15.55)} L${W - 18},${y(15.55) + 6}`} />
        <text x={W - 10} y={y(15.55) - 10} text-anchor="end">{dakar} · 570 km</text>
      </g>
      <g class="scale" aria-hidden="true" transform={`translate(${x(-24.2)} ${y(17.22)})`}>
        <path d={`M0,0 v-5 M0,0 H${scalePx.toFixed(1)} v-5`} />
        <text x={(scalePx / 2).toFixed(1)} y="16" text-anchor="middle">{scaleKm} km</text>
      </g>
    </svg>

    <div class="isl-panel" aria-live="polite">
      <p class="isl-hint">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="M9 11V5a2 2 0 0 1 4 0v5m0-1a2 2 0 0 1 4 0v2m0-1a2 2 0 0 1 4 0v4a7 7 0 0 1-7 7h-1.5a6 6 0 0 1-4.6-2.1L4 15.5a1.8 1.8 0 0 1 2.7-2.4L9 15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {s.map.hint}
      </p>
      {islands.map((i) => (
        <div class="isl-card" id={`isl-card-${i.k}`} data-card={i.k} hidden>
          <div class="isl-head">
            <p class="isl-name">{i.name}</p>
            {i.info.prAnnual != null && <p class="isl-rain"><span class="visually-hidden">{s.map.rain}: </span><strong>~{nf(i.info.prAnnual)}</strong> {s.map.perYear}</p>}
          </div>
          <p class="isl-facts">
            <span><span class="visually-hidden">{s.map.area}: </span>{nf(i.info.area)} km²</span>
            {i.info.tasAnnual != null && <span><span class="visually-hidden">{s.map.temp}: </span>{nf(i.info.tasAnnual, 1)} °C{i.info.pointElevation != null && <span class="isl-at"> {s.map.at} {nf(i.info.pointElevation)} m</span>}</span>}
            <span><span class="visually-hidden">{s.map.peak}: </span>▲ {i.info.peak} {nf(i.info.elevation)} m</span>
          </p>
          {i.info.prMonthly && (
            <div class="isl-bars" role="img" aria-label={`${s.map.rainByMonth}: ${i.info.prMonthly.map((v, m) => `${s.months[m]} ${nf(v)} mm`).join(', ')}`}>
              {i.info.prMonthly.map((v, m) => (
                <span class={m === i.wettest ? 'wet' : ''} style={`--h:${Math.max(2, (v / maxMonth) * 100).toFixed(1)}%`} title={`${s.months[m]}: ${nf(v)} mm`}></span>
              ))}
            </div>
          )}
          {i.info.prMonthly && <p class="isl-months" aria-hidden="true"><span>{s.months[0]}</span><span>{s.months[11]}</span></p>}
        </div>
      ))}
    </div>
  </div>
  <figcaption>{s.map.caption} <span class="isl-note">{s.map.note}</span></figcaption>
</figure>
