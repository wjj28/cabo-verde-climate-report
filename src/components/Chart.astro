---
// Renders a chart as static, accessible SVG at build time. No JavaScript is needed to read it;
// public/js/charts.js adds a hover/keyboard readout and scenario toggles on top.
import { W, H, M, scale, ticks, extent, linePath, bandPath, stripeColor, type ChartSpec } from '../lib/chart';

interface Props { spec: ChartSpec; id: string; title: string; desc: string; lang: string; /** stretch to fill its box (decorative backgrounds) */ stretch?: boolean }
const { spec, id, title, desc, lang, stretch = false } = Astro.props;
const nf = (v: number) => new Intl.NumberFormat(lang === 'ar' ? 'ar-u-nu-latn' : lang, { maximumFractionDigits: 1 }).format(v);
const iw = W - M.l - M.r;
const ih = H - M.t - M.b;

let body = '';
let readout: { x: (number | string)[]; series: { label: string; key: string; v: number[] }[]; unit: string } | null = null;

if (spec.kind === 'stripes') {
  const n = spec.points.length;
  const max = Math.max(...spec.points.map((p) => Math.abs(p.y)));
  const w = W / n;
  body = spec.points
    .map((p, i) => `<rect x="${(i * w).toFixed(2)}" y="0" width="${(w + 0.6).toFixed(2)}" height="${H - 24}" fill="${stripeColor(p.y, max)}"><title>${p.x}: ${p.y > 0 ? '+' : ''}${nf(p.y)} °C</title></rect>`)
    .join('');
  const first = spec.points[0].x, last = spec.points[n - 1].x;
  body += `<text class="tick" x="2" y="${H - 6}">${first}</text><text class="tick" x="${W - 2}" y="${H - 6}" text-anchor="end">${last}</text>`;
}

if (spec.kind === 'bars') {
  const pts = spec.points;
  const ys = pts.map((p) => p.y);
  const [lo, hi] = spec.domain ?? extent([...ys, 0], 0.06);
  const sy = scale(lo, hi, M.t + ih, M.t);
  const bw = iw / pts.length;
  const sx = (i: number) => M.l + i * bw;
  const yt = ticks(lo, hi, 5);
  body += yt.map((v) => `<line class="grid${v === 0 ? ' zero' : ''}" x1="${M.l}" x2="${W - M.r}" y1="${sy(v)}" y2="${sy(v)}"/><text class="tick" x="${M.l - 8}" y="${sy(v) + 5}" text-anchor="end">${nf(v)}</text>`).join('');
  body += pts
    .map((p, i) => {
      const y0 = sy(0), y1 = sy(p.y);
      const cls = spec.signed ? (p.y >= 0 ? 'bar pos' : 'bar neg') : spec.highlight?.includes(p.x) ? 'bar hl' : 'bar';
      const label = spec.xLabels ? spec.xLabels[i] : p.x;
      return `<rect class="${cls}" x="${(sx(i) + bw * 0.12).toFixed(1)}" width="${(bw * 0.76).toFixed(1)}" y="${Math.min(y0, y1).toFixed(1)}" height="${Math.max(0.5, Math.abs(y1 - y0)).toFixed(1)}"><title>${label}: ${spec.signed && p.y > 0 ? '+' : ''}${nf(p.y)} ${spec.unit}</title></rect>`;
    })
    .join('');
  // x labels: every label for ≤12 bars, otherwise decades
  body += pts
    .map((p, i) => {
      const show = spec.xLabels ? true : p.x % 10 === 0;
      if (!show) return '';
      const lab = spec.xLabels ? spec.xLabels[i] : p.x;
      return `<text class="tick" x="${(sx(i) + bw / 2).toFixed(1)}" y="${H - 10}" text-anchor="middle">${lab}</text>`;
    })
    .join('');
  body += `<text class="axis-label" x="${M.l}" y="${M.t - 4}" dy="-2">${spec.yLabel}</text>`;
  readout = { x: pts.map((p, i) => (spec.xLabels ? spec.xLabels[i] : p.x)), series: [{ label: spec.yLabel, key: 'v', v: ys }], unit: spec.unit };
}

if (spec.kind === 'lines') {
  const all = spec.series.flatMap((s) => s.points.flatMap((p) => [p.y, p.lo ?? p.y, p.hi ?? p.y]));
  const xs = spec.series.flatMap((s) => s.points.map((p) => p.x));
  const [x0, x1] = spec.xDomain ?? [Math.min(...xs), Math.max(...xs)];
  const [lo, hi] = spec.domain ?? extent(all, 0.06);
  const sx = scale(x0, x1, M.l, W - M.r);
  const sy = scale(lo, hi, M.t + ih, M.t);
  const yt = ticks(lo, hi, 5);
  const xt = ticks(x0, x1, 6).filter((v) => Number.isInteger(v));
  if (spec.shade) {
    const sx0 = sx(spec.shade.x0 - 0.5), sx1 = sx(spec.shade.x1 + 0.5);
    // keep the label inside the plot: anchor it to the band's right edge when it would overflow
    // label above the plot area, right-aligned to the band, so it never covers the data
    body += `<rect class="shade" x="${sx0}" width="${sx1 - sx0}" y="${M.t}" height="${ih}"/><text class="shade-label" x="${sx1}" y="${M.t - 6}" text-anchor="end">${spec.shade.label}</text>`;
  }
  body += yt.map((v) => `<line class="grid${v === 0 ? ' zero' : ''}" x1="${M.l}" x2="${W - M.r}" y1="${sy(v)}" y2="${sy(v)}"/><text class="tick" x="${M.l - 8}" y="${sy(v) + 5}" text-anchor="end">${nf(v)}</text>`).join('');
  // first/last year labels align inwards so they stay inside the chart and clear the y-axis labels
  body += xt.map((v) => {
    const px = sx(v);
    const anchor = px <= M.l + 2 ? 'start' : px >= W - M.r - 2 ? 'end' : 'middle';
    return `<text class="tick" x="${px}" y="${H - 10}" text-anchor="${anchor}">${v}</text>`;
  }).join('');
  for (const s of spec.series) {
    if (s.band) body += `<path class="band s-${s.key}" data-series="${s.key}" d="${bandPath(s.points, sx, sy)}"/>`;
  }
  for (const s of spec.series) {
    body += `<path class="line s-${s.key}${s.dashed ? ' dashed' : ''}" data-series="${s.key}" d="${linePath(s.points, sx, sy)}"/>`;
    const last = s.points.at(-1)!;
    body += `<circle class="end s-${s.key}" data-series="${s.key}" cx="${sx(last.x)}" cy="${sy(last.y)}" r="4"/>`;
  }
  body += `<text class="axis-label" x="${M.l}" y="${M.t - 4}" dy="-2">${spec.yLabel}</text>`;
  // readout grid: union of x values
  const allX = [...new Set(xs)].sort((a, b) => a - b);
  readout = {
    x: allX,
    series: spec.series.map((s) => ({ key: s.key, label: s.label, v: allX.map((x) => s.points.find((p) => p.x === x)?.y ?? NaN) })),
    unit: spec.unit,
  };
  (readout as any).geom = { x0, x1, l: M.l, r: W - M.r, lo, hi, t: M.t, b: M.t + ih };
}
if (spec.kind === 'bars' && readout) (readout as any).geom = { bars: true, l: M.l, r: W - M.r, t: M.t, b: M.t + ih };
---
<div class="chart" data-chart={id}>
  {spec.kind === 'lines' && spec.toggle && (
    <fieldset class="toggles" hidden>
      <legend class="visually-hidden">{title}</legend>
      {spec.series.map((s) => (
        <label class={`toggle s-${s.key}`}><input type="checkbox" checked data-toggle={s.key} /> <span class="swatch" aria-hidden="true"></span>{s.label}</label>
      ))}
    </fieldset>
  )}
  {spec.kind === 'lines' && !spec.toggle && (
    <ul class="legend">{spec.series.map((s) => <li class={`s-${s.key}`}><span class="swatch" aria-hidden="true"></span>{s.label}</li>)}</ul>
  )}
  <div class="plot" dir="ltr">
    <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio={stretch ? 'none' : undefined} role="img" aria-labelledby={`${id}-t ${id}-d`} xmlns="http://www.w3.org/2000/svg" class={`svg-${spec.kind}`}>
      <title id={`${id}-t`}>{title}</title>
      <desc id={`${id}-d`}>{desc}</desc>
      <g set:html={body} />
    </svg>
    <div class="readout" aria-hidden="true" hidden></div>
  </div>
  {readout && <script type="application/json" class="chart-data" set:html={JSON.stringify(readout)} />}
</div>
